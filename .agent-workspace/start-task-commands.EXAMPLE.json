{
    "version": 1,
    "description": "Commands to run inside a newly cloned task repo before implementation starts.",
    "commands": [
        {
            "name": "Example command",
            "run": "echo \"Configure start-task commands in .agent-workspace/start-task-commands.json\"",
            "continue_on_error": true,
            "enabled": false
        },
        {
            "name": "Example with on_fail recovery",
            "run": "yarn install",
            "continue_on_error": false,
            "enabled": false,
            "on_fail": {
                "continue_on_success": true,
                "commands": [
                    {
                        "name": "yarn clean install",
                        "run": "yarn clean && yarn install",
                        "enabled": true
                    }
                ]
            }
        }
    ]
}