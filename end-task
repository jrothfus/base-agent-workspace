#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKTREE_IDS_PATH="$WORKSPACE_ROOT/.agent-workspace/worktree-ids.json"
LOCKS_DIR="$WORKSPACE_ROOT/.agent-workspace/locks"

# ------------------------------------------------------------------
# Determine the task path to end
# ------------------------------------------------------------------
task_path=""

# Check if CWD basename matches any known worktree ID (via python for portability)
cwd_basename="$(basename "$PWD")"
cwd_is_worktree="$(python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    ids = json.load(f)
print('yes' if sys.argv[2] in ids else 'no')
" "$WORKTREE_IDS_PATH" "$cwd_basename")"

if [[ "$cwd_is_worktree" == "yes" ]]; then
  # We're sitting inside a worktree — use CWD
  task_path="$PWD"
else
  # Not in a worktree. Build a menu from active locks.
  active_tasks=()   # display names (symlink name or ID)
  active_paths=()   # corresponding paths to pass to end_task.py

  if [[ ! -d "$LOCKS_DIR" ]]; then
    echo "No active tasks found (locks directory does not exist)." >&2
    exit 1
  fi

  for lock_path in "$LOCKS_DIR"/*/; do
    [[ -d "$lock_path" ]] || continue
    lock_id="$(basename "$lock_path")"

    # Find a symlink in workspace root that resolves to this worktree
    worktree_dir="$WORKSPACE_ROOT/.agent-workspace/worktrees/$lock_id"
    symlink_name=""
    for item in "$WORKSPACE_ROOT"/*/; do
      item="${item%/}"
      if [[ -L "$item" ]]; then
        target="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$item")"
        if [[ "$target" == "$worktree_dir" ]]; then
          symlink_name="$(basename "$item")"
          break
        fi
      fi
    done

    if [[ -n "$symlink_name" ]]; then
      active_tasks+=("$symlink_name")
      active_paths+=("$WORKSPACE_ROOT/$symlink_name")
    else
      active_tasks+=("$lock_id")
      active_paths+=("$worktree_dir")
    fi
  done

  if [[ ${#active_tasks[@]} -eq 0 ]]; then
    echo "No active tasks found." >&2
    exit 1
  fi

  if [[ ${#active_tasks[@]} -eq 1 ]]; then
    # Only one active task — confirm and proceed
    echo "Active task: ${active_tasks[0]}"
    read -r -p "End this task? [y/N] " confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
      echo "Aborted." >&2
      exit 1
    fi
    task_path="${active_paths[0]}"
  else
    # Multiple tasks — present a numbered menu
    echo "Active tasks:"
    for i in "${!active_tasks[@]}"; do
      printf "  %d) %s\n" "$((i + 1))" "${active_tasks[$i]}"
    done
    echo ""
    while true; do
      read -r -p "Select task to end [1-${#active_tasks[@]}]: " choice
      if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#active_tasks[@]} )); then
        task_path="${active_paths[$((choice - 1))]}"
        break
      fi
      echo "Invalid selection. Enter a number between 1 and ${#active_tasks[@]}."
    done
  fi
fi

echo ""
python3 "$WORKSPACE_ROOT/.scripts/end_task.py" "$task_path"
