#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Split args on '--': everything before is the description, everything after is the prompt
description_parts=()
prompt_parts=()
saw_separator=false

for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then
    saw_separator=true
  elif [[ "$saw_separator" == false ]]; then
    description_parts+=("$arg")
  else
    prompt_parts+=("$arg")
  fi
done

if [[ ${#description_parts[@]} -eq 0 ]]; then
  echo "Usage: bash start-task <description> [-- <agent prompt>]" >&2
  echo "  Example: bash start-task fix login bug -- implement OAuth login flow" >&2
  exit 1
fi

description="${description_parts[*]}"
prompt="${prompt_parts[*]:-}"

# Set terminal tab title to the task description
printf '\033]0;%s\007' "$description"

# Run python setup and capture output; extract the symlink path from the last SYMLINK_PATH= line
output="$(python3 "$WORKSPACE_ROOT/.scripts/start_task.py" "$description")"
printf '%s\n' "$output"

symlink_path="$(printf '%s\n' "$output" | grep '^SYMLINK_PATH=' | tail -1 | cut -d= -f2-)"

if [[ -z "$symlink_path" ]]; then
  echo "Error: could not determine symlink path from start_task output" >&2
  exit 1
fi

# Open VS Code at the symlink (background, non-blocking)
echo ""
echo "Opening VS Code at $symlink_path"
code "$symlink_path" &

# cd into the symlink dir, run claude as a subprocess so the shell stays alive after it exits
cd "$symlink_path"

if [[ -n "$prompt" ]]; then
  echo "Starting claude in $symlink_path"
  echo "When done, run: bash ../end-task"
  echo ""
  claude "$prompt"
else
  echo "Workspace ready. When done, run: bash ../end-task"
fi
